# RNF-ARQ-001: Complete environment configuration for WMS Enterprise 3PL
# Copy to .env and fill in actual values for your environment

# Application
NODE_ENV=development
APP_ROLE=api  # Options: api|worker|scheduler

# API Service
API_HOST=0.0.0.0
API_PORT=3000
API_BASE_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# PostgreSQL (RG-010: UTC timestamps, strict typing)
# POSTGRES_USER/PASSWORD: admin/owner credentials. Used ONLY by the Postgres
# container bootstrap and by MigrationRunner (DatabaseModule) to run DDL
# (CREATE ROLE/SCHEMA/TABLE) — NEVER by the application's request-path pool.
DATABASE_URL=postgresql://wms_app:wms_app_password@postgres:5432/wms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_root_password
POSTGRES_DB=wms_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# App role (RNF-ARQ-011) [INVIOLÁVEL]: non-superuser, RLS-enforced. This is the
# ONLY role DatabaseService's request-path pool connects as.
POSTGRES_APP_USER=wms_app
POSTGRES_APP_PASSWORD=wms_app_password

# Worker role (RNF-ARQ-031, ADR-006): BYPASSRLS, used ONLY by outbox-publisher and
# realtime-fanout background workers for cross-tenant polling. Never used from HTTP.
POSTGRES_WORKER_USER=wms_worker
POSTGRES_WORKER_PASSWORD=wms_worker_password

# Redis (RNF-ARQ-001: Cache and Pub/Sub)
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=wms
MINIO_ENDPOINT=http://minio:9000
MINIO_API_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Logging (RNF-ARQ-070: Structured logging with trace/span IDs)
LOG_LEVEL=info
LOG_FORMAT=json  # Options: json|pretty

# Timezone (RG-010: Warehouse timezone for display)
WAREHOUSE_TIMEZONE=America/Sao_Paulo

# Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# CORS (for portal client)
CORS_ORIGIN=http://localhost:3002

# Observability (placeholder for OTel - Session 1)
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=wms-api

# Feature Flags (for future use)
FEATURE_RLS_ENABLED=true
FEATURE_FISCAL_MODULE=true
FEATURE_PWA_OFFLINE=true
