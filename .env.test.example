# Sessão 4A, item 0 — modelo do .env.test (instância de teste isolada do
# stack de desenvolvimento). Copie para .env.test na raiz do repositório.
# Sobe a infraestrutura com:
#   docker compose -f infra/docker-compose.test.yml up -d --wait

NODE_ENV=test

# PostgreSQL isolado — porta 5433 (dev usa 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=wms_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_root_password
POSTGRES_ADMIN_PASSWORD=postgres_root_password

POSTGRES_APP_USER=wms_app
POSTGRES_APP_PASSWORD=wms_app_password

POSTGRES_WORKER_USER=wms_worker
POSTGRES_WORKER_PASSWORD=wms_worker_password

# Redis isolado — porta 6380 (dev usa 6379)
REDIS_URL=redis://localhost:6380/0
REDIS_HOST=localhost
REDIS_PORT=6380

# MinIO isolado — porta 9002 (dev usa 9000/9001)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=wms-test
MINIO_ENDPOINT=http://localhost:9002
MINIO_API_URL=http://localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

JWT_SECRET=test-jwt-secret-isolated-nao-usar-em-producao
LOG_LEVEL=warn
