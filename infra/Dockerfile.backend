# RNF-ARQ-003: Backend container (api|worker|scheduler) with app_role switching
FROM node:20-slim

WORKDIR /app

# DOC-12 RF-SEG-002: argon2 (senhas) não tem binário pré-compilado para esta
# combinação de plataforma/arquitetura e precisa compilar nativamente via
# node-gyp, que exige Python + toolchain de build — ausentes na imagem slim.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm@9.0.0

# Copy entire monorepo (use .dockerignore to exclude large artifacts)
COPY . .

# Install dependencies and build in Linux environment. Use turbo (root "build"
# script), NOT `pnpm -C apps/backend run build` directly: apps/backend depends
# on @wms/contracts (workspace:*), whose dist/ is never emitted unless turbo
# builds it first via the "^build" pipeline dependency (turbo.json).
RUN pnpm install && pnpm run build --filter @wms/backend

# Cleanup source code but keep dist and node_modules. Do NOT delete `packages`:
# pnpm workspace deps (e.g. @wms/contracts) are symlinked from node_modules
# into packages/*/dist — deleting the source dir breaks the symlink target and
# the app fails at runtime with ERR_MODULE_NOT_FOUND.
RUN rm -rf \
    apps/backend/src \
    apps/frontend \
    apps/edge-agent \
    docs \
    migrations \
    .turbo \
    .eslintrc.json \
    .prettierrc.json \
    tsconfig.json \
    turbo.json

# Create non-root user for security (optional, can remove if needed)
# RUN groupadd -r nodejs && useradd -r -g nodejs nodejs
# USER nodejs

# Health check. Only the api role listens on HTTP (worker/scheduler have no
# server — main.ts only calls app.listen() for APP_ROLE=api), so this exits 0
# immediately for the other roles. For api, the response stream MUST be
# drained (r.resume()) and the process MUST call process.exit() explicitly —
# otherwise the open socket keeps the event loop alive and every check hangs
# until Docker's --timeout kills it, permanently reporting unhealthy.
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "if (process.env.APP_ROLE && process.env.APP_ROLE !== 'api') { process.exit(0); } require('http').get('http://localhost:' + (process.env.API_PORT || 3000) + '/health/live', (r) => { r.resume(); r.on('end', () => process.exit(r.statusCode === 200 ? 0 : 1)); }).on('error', () => process.exit(1));"

# Start backend with APP_ROLE from environment (RNF-ARQ-003)
# Same image, three different roles via APP_ROLE env var
CMD ["node", "dist/apps/backend/main.js"]
