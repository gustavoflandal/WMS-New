{
  "name": "@wms/backend",
  "version": "0.0.1",
  "description": "WMS Enterprise 3PL Backend API",
  "type": "module",
  "main": "../../dist/apps/backend/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "docker compose -f ../../infra/docker-compose.test.yml up -d --wait postgres-test redis-test minio-test && docker compose -f ../../infra/docker-compose.test.yml run --rm minio-test-init",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "start:api": "APP_ROLE=api node ../../dist/apps/backend/main.js",
    "start:worker": "APP_ROLE=worker node ../../dist/apps/backend/main.js",
    "start:scheduler": "APP_ROLE=scheduler node ../../dist/apps/backend/main.js",
    "db:seed": "node ../../infra/postgres/seeds/run-seed.mjs"
  },
  "keywords": [
    "wms",
    "warehouse",
    "3pl",
    "nestjs"
  ],
  "author": "WMS Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/websockets": "^10.3.0",
    "@socket.io/redis-adapter": "^8.2.0",
    "@wms/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "fast-xml-parser": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "prom-client": "^15.1.0",
    "redis": "^4.6.0",
    "socket.io": "^4.7.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^11.1.29",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/node-forge": "^1.3.11",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@wms/edge-agent": "workspace:*",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
